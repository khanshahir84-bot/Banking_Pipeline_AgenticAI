# Externally hosted, OpenAI-compatible LLM provider only. Do not configure a local endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-secret-manager-value
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
# Set true in deployed environments to fail safely instead of using the demo fallback.
LLM_REQUIRED=true
# development is only for local demonstrations. Production must use jwks.
AUTH_MODE=development
JWT_SECRET=change-me-before-production
# Production OIDC/JWKS settings (required when AUTH_MODE=jwks)
JWT_ISSUER=https://idp.bank.example
JWT_AUDIENCE=banking-chat
JWT_JWKS_URL=https://idp.bank.example/.well-known/jwks.json
DATABASE_PATH=/data/banking_chat.db
LOG_LEVEL=INFO
MAX_HISTORY_MESSAGES=10
